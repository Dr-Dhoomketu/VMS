{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/visitor-pass run build",
  "outputDirectory": "artifacts/visitor-pass/dist/public",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=*, microphone=*" }
      ]
    }
  ]
}
